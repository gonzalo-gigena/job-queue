# Local defaults. Copy to .env: cp .env.example .env
POSTGRES_USER=app
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=app
HTTP_PORT=8080
# Password for the dashboard and /api/admin/* (basic auth, any user name). Use a long random one in production.
ADMIN_TOKEN=local-dev-only

